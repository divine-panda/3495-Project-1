<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Height Results</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
    <h2>Height Statistics</h2>
    <table border="1">
        <tr>
            <th>Max Height</th>
            <th>Min Height</th>
            <th>Average Height</th>
        </tr>
        <tr id="dataRow">
            <td id="max"><%=max%></td>
            <td id="min"><%=min%></td>
            <td id="avg"><%=avg%></td>
        </tr>
    </table>
    </div>
</body>
</html>